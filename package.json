    "better-auth": "1.7.3",
    "input-otp": "^1.4.2",
    "react": "^19.2.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tailwindcss-react-aria-components": "^2.2.0",
