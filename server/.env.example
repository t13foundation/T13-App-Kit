# Local development configuration. No production secrets belong in this file.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

APP_NAME=Aplikacja
APP_URL=http://localhost:8080
AUTH_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:8080

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/appkit

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# Mailpit (docker compose up) — never a real mailbox in development.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=no-reply@localhost

# Only used by the integration test suite.
MAILPIT_API=http://127.0.0.1:8025
