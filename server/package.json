{
  "name": "@t13/app-kit-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "better-auth generate --config src/auth.ts --output src/db/auth-schema.ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.3",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@react-email/components": "^1.0.12",
    "better-auth": "1.7.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "nodemailer": "^7.0.9",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
