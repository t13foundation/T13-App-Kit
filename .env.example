# Public, bundled into the browser. Copy ONLY a publishable key (or local anon JWT).
# Never put a Supabase secret/service_role key in any VITE_* variable.
# Leave both blank to browse the introduction/catalog without an account backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy backend only, server-side. Retained for the pre-Supabase rollback path.
API_INTERNAL_URL=http://127.0.0.1:3001
